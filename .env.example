# ---------------------------------------------------------------
# Copy this file to `.env` (same folder) and fill in your values.
# On Vercel, add the same keys under Project → Settings → Environment Variables.
# ---------------------------------------------------------------

# MongoDB connection string ("database path"). Leave empty to serve the built-in dummy data.
#   Local MongoDB:  mongodb://127.0.0.1:27017/portfolio
#   MongoDB Atlas:  mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
MONGO_URI=

# Port for the local API server (Vercel ignores this)
PORT=5000

# Secret for GET /api/admin/inquiries (send it as the `x-admin-key` header). Leave empty to disable.
ADMIN_KEY=

# Only needed if the frontend is hosted on a different domain than the API (comma-separated)
CLIENT_URL=
