{
  "name": "mern-developer-portfolio",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "MERN developer portfolio: React (Vite) frontend + Express/Mongoose API, deployable to Vercel.",
  "scripts": {
    "setup": "npm install && cd client && npm install",
    "dev": "concurrently -n api,web -c magenta,cyan \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --watch server/server.js",
    "dev:web": "cd client && npm run dev",
    "build": "cd client && npm install --include=dev && npm run build",
    "start": "node server/server.js",
    "seed": "node server/seed/seed.js",
    "seed:destroy": "node server/seed/seed.js --destroy"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "mongoose": "^8.7.0"
  },
  "devDependencies": {
    "concurrently": "^9.0.1"
  }
}
